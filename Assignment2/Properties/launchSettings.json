{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5032",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SERVICEBUS_CONNECTION_STRING": "Endpoint=sb://your-servicebus-namespace.servicebus.windows.net/;SharedAccessKeyName=containerapp-sender;SharedAccessKey=your-key",
        "SERVICEBUS_QUEUE_NAME": "messages"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:7047;http://localhost:5032",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "SERVICEBUS_CONNECTION_STRING": "Endpoint=sb://your-servicebus-namespace.servicebus.windows.net/;SharedAccessKeyName=containerapp-sender;SharedAccessKey=your-key",
        "SERVICEBUS_QUEUE_NAME": "messages"
      }
    }
  }
}